$background: #0B1117;
$surface: #182532;
$primary-dark: #0284C7;

ExpandedJobView {
    align: center middle;
    background: transparent;
}

#job-view {
    width: 85%;
    height: 85%;
    background: $surface;
    border: round $primary-dark;
    padding: 2;
}

VerticalScroll {
    width: 85%;
    height: 85%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

Markdown {
    text-align: left;
}

MarkdownH1 {
    text-align: left;
}